rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - preferences: list (optional)
    //   - fears: list (optional)
    //   - fetishes: list (optional)
    //   - desires: list (optional)
    //   - loves: list (optional)
    //   - lastUpdated: string (optional)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "jurvanen.niko1@gmail.com" && request.auth.token.email_verified == true)); // Default admin
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /messages/{messageId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /snapshots/{snapshotId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /lilithProfile/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
